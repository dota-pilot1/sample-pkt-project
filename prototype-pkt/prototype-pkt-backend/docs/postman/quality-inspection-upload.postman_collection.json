{
  "info": {
    "name": "PKT 품질 검사 결과 및 이미지 업로드",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4201/api" },
    { "key": "accessToken", "value": "" },
    { "key": "inspectionId", "value": "1" },
    { "key": "presignedUrl", "value": "" },
    { "key": "publicUrl", "value": "" }
  ],
  "item": [
    {
      "name": "1. 검사 사진 Presigned URL 발급",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"defect-photo.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"size\": 102400,\n  \"folder\": \"quality-inspections\"\n}"
        },
        "url": "{{baseUrl}}/upload/presign"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Presigned URL is issued', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('presignedUrl', body.presignedUrl);",
            "pm.collectionVariables.set('publicUrl', body.publicUrl);"
          ]
        }
      }]
    },
    {
      "name": "2. S3로 검사 사진 PUT",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "image/jpeg" }],
        "body": { "mode": "file", "file": { "src": "" } },
        "url": "{{presignedUrl}}"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('Photo is uploaded', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"] }
      }]
    },
    {
      "name": "3. 품질 검사 결과 업데이트",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dimension\": 51.2,\n  \"appearanceIssue\": true,\n  \"result\": \"FAIL\",\n  \"defectReason\": \"심한 긁힘 발견\",\n  \"photoUrls\": [\"{{publicUrl}}\"]\n}"
        },
        "url": "{{baseUrl}}/quality-inspections/{{inspectionId}}/result"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Inspection is completed', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.status).to.eql('COMPLETED');",
            "pm.expect(body.result).to.eql('FAIL');",
            "pm.expect(body.photoUrls).to.include(pm.collectionVariables.get('publicUrl'));"
          ]
        }
      }]
    }
  ]
}
